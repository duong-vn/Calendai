# ========================================================
# Calendai Mobile (Expo / React Native) - Environment Config
# ========================================================

# 1. Calendai Backend URL
# Production: https://calendai.tduong.online
# Local dev with Android emulator: http://10.0.2.2:3000
# Local dev with physical phone: http://<your-lan-ip>:3000
EXPO_PUBLIC_API_URL=https://calendai.tduong.online

# 2. Google OAuth Web Client ID (Required for Google Sign-In on Android/iOS)
# Must match the Web Client ID created in Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# 3. Google OAuth iOS Client ID (Optional, only needed if building for iOS)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
